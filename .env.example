# Copie ce fichier en .env.local (ignoré par git) et renseigne tes clés Supabase.
# Sans ces variables, l'app fonctionne en mode local (localStorage), sans comptes.
# Les mêmes variables doivent AUSSI être ajoutées dans Vercel (Project Settings →
# Environment Variables) pour la production.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...(clé publique, pas la "service_role"/secret)
